VersionNumber = '2.92';
// VersionBuildStamp is rewritten by the build step with the build's date/time,
// so every local/debug build is visually distinct in the splash and About box.
// Delphi has no compile-date macro, so the stamp is injected here rather than
// via a compiler directive. 'dev' is the fallback when a build has not stamped it.
VersionBuildStamp = 'dev';
